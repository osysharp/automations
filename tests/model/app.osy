namespace AutomationsKitTests;

using Osysharp.Identity;
using Osysharp.Automations;

// A PRINT SHOP — what the rules are about is a `Job`. Printers take jobs and print them; only the manager decides that a
// job is a rush (the rule a printer's own automation meets when it fires).

[Role] enum ShopRole { Authenticator, Printer, Manager }

// Who prints here is the shop's to list (a job is given to one of them).
partial entity RoleGrant { security { allow read when IsPrinter; } }

policy IsPrinter => RoleGrant.Any(g => g.Member == user && (g.Role == ShopRole.Printer || g.Role == ShopRole.Manager));
policy IsManager => RoleGrant.Any(g => g.Member == user && g.Role == ShopRole.Manager);
/// The kit's two questions: printers work with automations and keep their own; the manager keeps the shop's.
policy RunsAutomations => IsPrinter;
policy ManagesAutomations => IsManager;

/// Somebody who signs in to the shop with a code — all a test needs.
entity Person : Principal {
  [MaxLength(200)] string CodeHash = "";
  security {
    allow read when IsAuthenticated || IsAuthenticator;
    allow create when IsAuthenticator;
    deny read CodeHash when !IsAuthenticator;
  }
}

/// Where a job is. ⚠ Appended, never inserted.
public enum JobStage { [Label("Queued")] Queued, [Label("Printing")] Printing, [Label("Ready")] Ready, [Label("Collected")] Collected }

/// What it is printed on.
public enum Paper { [Label("Plain")] Plain, [Label("Gloss")] Gloss, [Label("Recycled")] Recycled }

/// One print job.
entity Job {
  int Number;
  [Required, MaxLength(120)] string Title;
  JobStage Stage = JobStage.Queued;
  DateTime StageSince;
  int Copies = 1;
  Paper Paper = Paper.Plain;
  bool Rush;
  /// Who is printing it — a printer's own rules run on their jobs.
  Person? Operator;
  [MaxLength(300)] string Labels = "";
  /// Held back until this day, and why — set by `HoldUntil`, an action that takes a date and a list.
  DateOnly? HeldUntil;
  [MaxLength(300)] string HeldFor = "";
  /// What the job cost the shop — the manager's to read, so a printer's rule never asks it.
  decimal Cost;
  /// The shop's own bookkeeping — no rule asks it.
  [NotInRules, MaxLength(40)] string LedgerRef = "";
  security {
    allow read, create, update when IsPrinter;
    // Only the manager says a job is a rush, and reads what it cost.
    deny update Rush when !IsManager;
    deny read Cost when !IsManager;
  }
}

/// The shop's own history of a job — where each rule's run is written (`AutomationRan`), said in the reader's words.
entity JobNote {
  [Required] Job Job;
  [Required, MaxLength(1000)] string Says;
  DateTime At;
  security { allow read when IsPrinter; }
}

// ── what happens to a job — the shop's events, which its rules run on ─────────────────────────────────────────────────

[Event("A job is placed")]
public sealed class JobPlaced { public Job Job; }

[Event("A job changes")]
public sealed class JobChanged { public Job Job; }

[Event("A job is ready")]
public sealed class JobReady { public Job Job; }

/// Each rule's run is a line in the job's history.
[On]
void NoteTheRun(AutomationRan e) {
  if (e.Record is Job j) { new JobNote { Job = j, Says = FireSentence(e.Fire), At = e.Fire.At }; }
}

app.Automations = new AutomationsSetup { Subjects = [new AutomationsKitTests.JobRules()] };

/// What the shop adds to the rules about jobs: the two it ships with, what the hourly clock looks at, and whose a job is.
/// What a rule may ask of a job — its stage, paper, copies, title, how long in its stage — is the job's own fields.
public class JobRules : AutomationSubject<Job> {
  public override List<AutomationDefault> Defaults() {
    return [
      new AutomationDefault {
        Key = "big-runs-recycled", Name = "Big runs go on recycled paper", When = On<JobPlaced>(),
        If = [Test(j => j.Copies, AtLeast, 500)],
        Then = [Run(j => UsePaper(j, Paper.Recycled))],
      },
      // Shipped switched off: nothing runs when a job is ready until the team switches it on.
      new AutomationDefault {
        Key = "ready-shelved", Name = "Ready jobs go on the shelf", When = On<JobReady>(), Off = true,
        Then = [Run(j => AddLabel(j, "shelved"))],
      },
      new AutomationDefault {
        Key = "uncollected", Name = "Ready two days — uncollected", Hourly = true,
        If = [Test(j => j.Stage, Is, JobStage.Ready), Test(j => j.StageSince, AtLeast, TimeSpan.FromHours(48))],
        Then = [Run(j => AddLabel(j, "uncollected"))],
      },
    ];
  }

  public override List<Entity> Watching() {
    List<Entity> all = [];
    foreach (var j in Job.Where(j => j.Stage != JobStage.Collected).ToList()) { all.Add(j); }
    return all;
  }
  public override Principal? HolderOf(Entity record) {
    if (record is Job j && j.Operator != null) { return j.Operator; }
    return null;
  }
}

// ── what can be done to a job — the shop's own verbs, offered to its rules ────────────────────────────────────────────

/// Mark a job a rush — or not. Only the manager may.
[Action("Mark it a rush")]
public string MarkRush(Job job, [Label("Rush")] bool rush) {
  job.Rush = rush;
  Raise(new JobChanged { Job = job });
  UnitOfWork.Commit();
  return rush ? "Marked a rush." : "No longer a rush.";
}

/// Print it on another paper.
[Action("Use paper")]
public string UsePaper(Job job, Paper paper) {
  if (job.Paper == paper) { return ""; }
  job.Paper = paper;
  Raise(new JobChanged { Job = job });
  UnitOfWork.Commit();
  return "Paper set to " + paper.Label + ".";
}

/// Give it to a printer.
[Action("Give it to")]
public void GiveTo(Job job, [Label("Printer")] [Choices(PrinterChoices)] Person printer) {
  job.Operator = printer;
  Raise(new JobChanged { Job = job });
  UnitOfWork.Commit();
}

/// Label it — the label is made of the words.
[Action("Add a label")]
public void AddLabel(Job job, [Label("Label")] string label) {
  var clean = label.Trim().ToLower();
  if (clean == "") { throw new ValidationException("A label needs a word."); }
  if (!(" " + job.Labels + " ").Contains(" " + clean + " ")) { job.Labels = (job.Labels + " " + clean).Trim(); }
  UnitOfWork.Commit();
}

/// Hold a job back until a day, saying why — a date and a list, the kinds a rule's step used to take as blind text.
[Action("Hold it")]
public string HoldUntil(Job job, [Label("Until")] DateOnly until, [Label("Reasons")] List<string> reasons, [Label("Days of grace")] int grace = 0) {
  job.HeldUntil = until.AddDays(grace);
  job.HeldFor = string.Join(", ", reasons);
  UnitOfWork.Commit();
  return "Held until " + job.HeldUntil.Value.ToString("yyyy-MM-dd") + ".";
}

/// The printers a job may be given to — whoever prints here, by name.
[SuppressWarning("cost-unbounded-read")]   // the test shop's printers and managers
public List<ActionChoice> PrinterChoices() {
  List<ActionChoice> all = [];
  foreach (var g in RoleGrant.Include(x => x.Member).Where(x => x.Role == ShopRole.Printer || x.Role == ShopRole.Manager).ToList()) {
    if (all.Any(c => c.Key == g.Member.Id.ToString())) { continue; }
    all.Add(new ActionChoice { Key = g.Member.Id.ToString(), Label = g.Member.DisplayName });
  }
  return all.OrderBy(c => c.Label).ToList();
}

// ── the shop's own work, raising its events ─────────────────────────────────────────────────────────────────────────

/// A job comes in.
public Guid PlaceJob(string title, int copies = 1, Paper paper = Paper.Plain) {
  var number = Job.Count() + 1;
  var job = new Job { Number = number, Title = title, Copies = copies, Paper = paper, StageSince = DateTime.UtcNow };
  Raise(new JobPlaced { Job = job });
  UnitOfWork.Commit();
  return job.Id;
}

/// A job moves on.
public void MoveJob(Guid id, JobStage stage) {
  var job = Job.Single(j => j.Id == id);
  if (job.Stage == stage) { return; }
  job.Stage = stage;
  job.StageSince = DateTime.UtcNow;
  if (stage == JobStage.Ready) { Raise(new JobReady { Job = job }); } else { Raise(new JobChanged { Job = job }); }
  UnitOfWork.Commit();
}

/// Take a job to print it.
public void TakeJob(Guid id) {
  var job = Job.Single(j => j.Id == id);
  job.Operator = Person.Single(p => p.Id == Session.CurrentUser!.Id);
  UnitOfWork.Commit();
}

/// What the shop's history says about a job, oldest first.
public List<string> NotesOn(Guid id) {
  return JobNote.Where(n => n.Job.Id == id).OrderBy(n => n.At).ToList().Select(n => n.Says).ToList();
}
